<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <AssemblyName>VelociHub</AssemblyName>
    <RootNamespace>VelociHub</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Veloci Hub</Product>
    <AssemblyTitle>Veloci Hub</AssemblyTitle>
    <Description>Veloci Hub — MX300 轻量本地控制台</Description>
    <Company>therehore</Company>
    <Authors>therehore</Authors>
    <Copyright>Copyright © 2026 therehore</Copyright>
    <RepositoryUrl>https://github.com/therehore/VelociHub</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/therehore/VelociHub</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType>none</DebugType>
    <!-- WPF + WinForms 混合时，DPI 感知必须留在 manifest 中（否则 WPF 变模糊） -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**\*.bak" />
  </ItemGroup>

</Project>
