<Window x:Class="Mx300Hub.UI.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Mx300Hub.UI.Controls"
        Width="388" Height="96"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" UseLayoutRounding="True" FontFamily="{StaticResource UiFont}">

    <Grid x:Name="Host" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Shift" Y="16" />
        </Grid.RenderTransform>

        <Viewbox x:Name="CardScale" Stretch="Fill">
        <Border x:Name="CardBorder" Width="388" Height="96" CornerRadius="15" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F2141620" Offset="0" />
                    <GradientStop Color="#F20B0D13" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.5" Color="#000000" />
            </Border.Effect>

            <Grid>
            <Grid x:Name="ContentRoot" Margin="14,10">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ContentShift" Y="8" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="56" Height="56" VerticalAlignment="Center">
                    <ctrl:BatteryRing x:Name="Ring" Level="-1" RingWidth="6" />
                    <TextBlock x:Name="LevelText" Text="--%" FontFamily="{StaticResource DisplayFont}"
                               FontSize="16" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <Border x:Name="DpiBadge" CornerRadius="28" Visibility="Collapsed"
                            Background="#337A5CFF" BorderBrush="#667A5CFF" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="DpiValueText" Text="800" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="DPI" FontSize="7.5" Foreground="#C3B6FF" Margin="0,-2,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="电量不足" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="BodyText" Text="建议尽快充电" Style="{StaticResource TxtBody}"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>

                <!-- 右侧：常驻品牌标 + 状态胶囊 -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ctrl:BrandLogo x:Name="BrandMark" Width="21" Height="21"
                                    HorizontalAlignment="Right" Opacity="0" />
                    <Border x:Name="TagChip" Background="#26FF5F66" CornerRadius="6" Padding="7,3,8,3"
                            Margin="0,5,0,0" HorizontalAlignment="Right">
                        <TextBlock x:Name="TagText" Text="预警" FontSize="10"
                                   Foreground="#FF9AA0" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 开场：品牌标旋转弹入 → 上移淡出 → 内容浮现 -->
            <Canvas x:Name="SplashLayer" IsHitTestVisible="False">
                <ctrl:BrandLogo x:Name="SplashLogo" Width="40" Height="40"
                                Canvas.Left="174" Canvas.Top="28"
                                Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <ctrl:BrandLogo.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SplashScale" ScaleX="0.25" ScaleY="0.25" />
                            <RotateTransform x:Name="SplashRotate" Angle="-180" />
                            <TranslateTransform x:Name="SplashShift" X="0" Y="0" />
                        </TransformGroup>
                    </ctrl:BrandLogo.RenderTransform>
                </ctrl:BrandLogo>
            </Canvas>
            </Grid>
        </Border>
        </Viewbox>
    </Grid>
</Window>
